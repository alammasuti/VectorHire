# Copy this file to .env and fill in your real values
# Never commit .env to git

# Accepts either an OpenAI key (sk-...) or an OpenRouter key (sk-or-v1-...)
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here

# SQL Server connection details
DB_SERVER=YOUR_SERVER\INSTANCE
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
DB_TABLE=SoulsoftJobApplication

# LLM model to use (OpenAI or OpenRouter model name)
LLM_MODEL=gpt-4o-mini

# ── Semantic search (optional) ───────────────────────────────────────────────
# Embeddings power synonym-aware skill search. By default they use OPENAI_API_KEY:
# an OpenAI key (sk-...) calls OpenAI, an OpenRouter key (sk-or-...) calls OpenRouter.
# Set these only to use a different key/provider for embeddings.
# EMBED_API_KEY=sk-your-openai-key
# EMBED_API_BASE=https://api.openai.com/v1
# EMBED_MODEL=text-embedding-3-small

# Set to false to turn semantic search off (plain text-to-SQL only)
# SEMANTIC_SEARCH=true

# Tuning: how many results to return and the minimum similarity score (0-1)
# SEMANTIC_SKILL_TOP_K=8
# SEMANTIC_SKILL_MIN_SCORE=0.5
# SEMANTIC_CANDIDATE_TOP_K=10
# SEMANTIC_CANDIDATE_MIN_SCORE=0.3
