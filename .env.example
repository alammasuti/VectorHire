# Copy this file to .env and fill in your real values
# Never commit .env to git

# Accepts either an OpenAI key (sk-...) or an OpenRouter key (sk-or-v1-...)
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here

# SQL Server connection details
# Use a read-only login that only has SELECT on DB_TABLE, never sa or an admin.
# See "Use a read-only database user" in README.md for the SQL to create one.
DB_SERVER=YOUR_SERVER\INSTANCE
DB_NAME=your_database_name
DB_USER=vectorhire_reader
DB_PASSWORD=your_password
DB_TABLE=SoulsoftJobApplication

# LLM model to use (OpenAI or OpenRouter model name)
LLM_MODEL=gpt-4o-mini
